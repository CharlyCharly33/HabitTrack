---
import MarketingLayout from '../layouts/MarketingLayout.astro'
---

<MarketingLayout title="HabitTrack — Crear cuenta" description="Crea tu cuenta en HabitTrack y empieza tu constancia.">
  <main class="mx-auto w-full max-w-[1600px] px-5 py-16 sm:px-8 sm:py-20 lg:w-[92%] lg:px-0">
    <p class="text-[0.65rem] font-bold tracking-[0.2em] text-[var(--color-accent)]">REGISTRO</p>
    <h1 class="mt-4 text-4xl font-black tracking-[-0.06em] sm:text-6xl">Empieza tu<br />constancia.</h1>
    <p class="mt-5 max-w-md text-sm leading-relaxed text-black/60">Crea tu cuenta y registra tu primer hábito en menos de un minuto.</p>
    <p class="mt-8 max-w-md border border-[var(--color-border)] bg-[var(--color-surface)] p-6 text-sm leading-relaxed text-black/60">Formulario de registro en construcción. Fase 1: pantalla visual.</p>
    <p class="mt-8 text-[0.65rem] font-bold tracking-[0.14em] text-black/55">¿YA TIENES CUENTA? <a class="text-[var(--color-accent)]" href="/login">INICIA SESIÓN</a></p>
  </main>
</MarketingLayout>
