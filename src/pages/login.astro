---
import MarketingLayout from '../layouts/MarketingLayout.astro'
---

<MarketingLayout title="HabitTrack — Iniciar sesión" description="Inicia sesión en HabitTrack y retoma tus hábitos.">
  <main class="mx-auto w-full max-w-[1600px] px-5 py-16 sm:px-8 sm:py-20 lg:w-[92%] lg:px-0">
    <p class="text-[0.65rem] font-bold tracking-[0.2em] text-[var(--color-accent)]">LOGIN</p>
    <h1 class="mt-4 text-4xl font-black tracking-[-0.06em] sm:text-6xl">HabitTrack<br />2.0</h1>
    <p class="mt-5 max-w-md text-sm leading-relaxed text-black/60">Inicia sesión para ver tus hábitos de hoy y tu constancia.</p>
    <p class="mt-8 max-w-md border border-[var(--color-border)] bg-[var(--color-surface)] p-6 text-sm leading-relaxed text-black/60">Formulario de acceso en construcción. Fase 1: pantalla visual.</p>
    <p class="mt-8 text-[0.65rem] font-bold tracking-[0.14em] text-black/55">¿SIN CUENTA? <a class="text-[var(--color-accent)]" href="/register">CREA UNA</a></p>
  </main>
</MarketingLayout>
