---
import AppLayout from '../../layouts/AppLayout.astro'
import ProgressSummary from '../../components/dashboard/ProgressSummary.astro'

// Mock temporal de Fase 1. Sin historial real ni cálculo de rachas.
// Cuando no haya datos, basta con poner hasData en false.
const hasData = true
const lastDays = [true, true, true, true, false, true, true, true, true, true, false, true, true, false]
---

<AppLayout title="HabitTrack — Progreso" description="Tu constancia, tus rachas y tu historial reciente.">
  <main class="mx-auto w-full max-w-[1600px] px-5 py-12 sm:px-8 sm:py-16 lg:w-[92%] lg:px-0">
    <p class="text-[0.65rem] font-bold tracking-[0.2em] text-[var(--color-accent)]">PROGRESO</p>
    <h1 class="mt-4 text-4xl font-black tracking-[-0.06em] sm:text-6xl">Tu constancia<br />en una pantalla.</h1>
    <div class="mt-8">
      {hasData ? (
        <ProgressSummary
          consistency={82}
          currentStreak={6}
          bestStreak={14}
          lastDays={lastDays}
          strong={[{ title: 'Hidratación', percentage: 100 }]}
          weak={[{ title: 'Lectura', percentage: 57 }]}
        />
      ) : (
        <div class="border border-[var(--color-border)] bg-[var(--color-surface)] p-8 sm:p-12">
          <p class="text-[0.65rem] font-bold tracking-[0.2em] text-[var(--color-accent)]">EMPEZAR</p>
          <h2 class="mt-4 text-3xl font-black tracking-[-0.06em] sm:text-4xl">Aún no hay suficientes datos.</h2>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-black/60">Completa tu primer día para empezar a ver tu constancia.</p>
        </div>
      )}
    </div>
  </main>
</AppLayout>
