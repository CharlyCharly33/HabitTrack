---
interface HabitHighlight {
  title: string
  percentage: number
}

interface Props {
  consistency: number
  currentStreak: number
  bestStreak: number
  lastDays: boolean[]
  strong: HabitHighlight[]
  weak: HabitHighlight[]
}

const { consistency, currentStreak, bestStreak, lastDays, strong, weak } = Astro.props
---

<div class="grid gap-px border border-[var(--color-border)] bg-black/20 sm:grid-cols-3" aria-label="Resumen de constancia">
  <div class="bg-[var(--color-surface)] p-6 sm:p-7">
    <p class="text-[0.6rem] font-bold tracking-[0.16em] text-black/50">CONSISTENCIA 7 DÍAS</p>
    <p class="mt-4 text-4xl font-black tracking-[-0.07em]">{consistency}<span class="text-[var(--color-accent)]">%</span></p>
  </div>
  <div class="bg-[var(--color-surface)] p-6 sm:p-7">
    <p class="text-[0.6rem] font-bold tracking-[0.16em] text-black/50">RACHA ACTUAL</p>
    <p class="mt-4 text-4xl font-black tracking-[-0.07em]">{currentStreak} <span class="text-xl">DÍAS</span></p>
  </div>
  <div class="bg-[var(--color-surface)] p-6 sm:p-7">
    <p class="text-[0.6rem] font-bold tracking-[0.16em] text-black/50">MEJOR RACHA</p>
    <p class="mt-4 text-4xl font-black tracking-[-0.07em]">{bestStreak} <span class="text-xl">DÍAS</span></p>
  </div>
</div>
<section class="mt-8 border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-7" aria-label="Últimos 14 días">
  <p class="text-[0.6rem] font-bold tracking-[0.16em] text-black/50">ÚLTIMOS 14 DÍAS</p>
  <div class="mt-5 grid grid-cols-7 gap-2">
    {lastDays.map((done, index) => (
      <span
        aria-hidden="false"
        aria-label={done ? `Día ${index + 1}: completado` : `Día ${index + 1}: pendiente`}
        role="img"
        class={`flex aspect-square items-center justify-center text-sm font-black ${done ? 'bg-black text-white' : 'border border-black/25 text-black/30'}`}
      >
        {done ? '✓' : '·'}
      </span>
    ))}
  </div>
</section>
<div class="mt-8 grid gap-px border border-[var(--color-border)] bg-black/20 sm:grid-cols-2">
  <section class="bg-[var(--color-surface)] p-6 sm:p-7" aria-label="Hábitos fuertes">
    <p class="text-[0.6rem] font-bold tracking-[0.16em] text-black/50">HÁBITOS FUERTES</p>
    <ul class="mt-5 flex flex-col gap-4">
      {strong.map((habit) => (
        <li class="flex items-baseline justify-between gap-3 border-b border-black/15 pb-3">
          <span class="text-lg font-black tracking-[-0.04em]">{habit.title}</span>
          <span class="text-[0.65rem] font-bold tracking-[0.14em] text-[var(--color-accent)]">{habit.percentage}%</span>
        </li>
      ))}
    </ul>
  </section>
  <section class="bg-[var(--color-surface)] p-6 sm:p-7" aria-label="Hábitos que necesitan atención">
    <p class="text-[0.6rem] font-bold tracking-[0.16em] text-black/50">NECESITAN ATENCIÓN</p>
    <ul class="mt-5 flex flex-col gap-4">
      {weak.map((habit) => (
        <li class="flex items-baseline justify-between gap-3 border-b border-black/15 pb-3">
          <span class="text-lg font-black tracking-[-0.04em]">{habit.title}</span>
          <span class="text-[0.65rem] font-bold tracking-[0.14em] text-black/45">{habit.percentage}%</span>
        </li>
      ))}
    </ul>
  </section>
</div>
