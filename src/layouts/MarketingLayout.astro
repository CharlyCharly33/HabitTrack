---
import Layout from './Layout.astro'

interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-[var(--color-background)] font-sans text-[var(--color-text)]">
    <div class="border-b border-[var(--color-border)]">
      <div class="mx-auto flex w-full max-w-[1600px] items-center justify-between px-5 py-4 sm:px-8 lg:w-[92%] lg:px-0">
        <a class="text-sm font-black tracking-[-0.04em]" href="/">HABITTRACK</a>
        <nav class="flex items-center gap-x-5 text-[0.65rem] font-bold tracking-[0.14em] text-black/55 sm:gap-x-8" aria-label="Navegación principal">
          <a class="transition-colors hover:text-[var(--color-accent)]" href="/login">INICIAR SESIÓN</a>
          <a class="bg-black px-4 py-2.5 text-white transition-colors hover:bg-[var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent)]" href="/register">EMPEZAR</a>
        </nav>
      </div>
    </div>
    <slot />
  </div>
</Layout>
